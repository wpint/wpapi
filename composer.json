{
    "name": "wpint/wpapi",
    "description": "The Wpint WPAPI package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Barzegar",
            "email": "ali.barzegar.rahimi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "wpint/contracts": "*",
        "wpint/support": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "antecedent/patchwork": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Wpint\\WPAPI\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wpint\\WPAPI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
